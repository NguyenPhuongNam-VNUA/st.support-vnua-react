# Supabase public project URL (được phép dùng để định danh project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chỉ dùng phía server. Không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# JWT ký bởi Next.js/Node.js. Sinh bằng: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=st-care
JWT_AUDIENCE=st-care-web

# Python AI Agent tương lai; browser không đọc các biến này.
PYTHON_AGENT_BASE_URL=http://127.0.0.1:5001
AI_AGENT_SERVICE_TOKEN=replace-with-an-internal-service-token



# ═══════════════════════════════════════════
# Python AI Agent
# ═══════════════════════════════════════════
AI_AGENT_SERVICE_TOKEN=your-secure-random-token-here
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=5001

# ═══════════════════════════════════════════
# Supabase / PostgreSQL
# ═══════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://st_ai_agent:password@db.your-project.supabase.co:5432/postgres

# ═══════════════════════════════════════════
# Google AI (Gemini)
# ═══════════════════════════════════════════
GOOGLE_API_KEY=your-google-api-key
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1024
GEMINI_LLM_MODEL=models/gemini-2.0-flash

# ═══════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════
# Local Models
# ═══════════════════════════════════════════
PROMPT_GUARD_MODEL_PATH=./models/llama-prompt-guard-2-86m
BGE_RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
RERANKER_TIMEOUT_MS=180
RERANKER_FALLBACK_TO_RRF=true

# ═══════════════════════════════════════════
# Observability
# ═══════════════════════════════════════════
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=st-care-ai-agent
PROMETHEUS_PORT=9090

# ═══════════════════════════════════════════
# Next.js (thêm vào .env hiện tại)
# ═══════════════════════════════════════════
PYTHON_AGENT_BASE_URL=http://127.0.0.1:5001
AI_AGENT_SERVICE_TOKEN=your-secure-random-token-here
