# Next.js application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (used only by the Next.js server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key

# Next.js session JWT
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=st-care
JWT_AUDIENCE=st-care-web

# Internal connection from Next.js to core-ai
PYTHON_AGENT_BASE_URL=http://127.0.0.1:5001
AI_AGENT_SERVICE_TOKEN=replace-with-a-long-random-shared-secret
CORE_AI_TENANT_ID=vnua

# Shared only between core-ai MCP and the Node internal business API
BUSINESS_API_TOKEN=replace-with-another-long-random-secret
