{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/api": ["./app/api"],
      "@/api/*": ["./app/api/*"],
      "@/components": ["./components"],
      "@/components/*": ["./components/*"],
      "@/contexts": ["./contexts"],
      "@/contexts/*": ["./contexts/*"],
      "@/data": ["./data"],
      "@/data/*": ["./data/*"],
      "@/icons": ["./icons"],
      "@/icons/*": ["./icons/*"],
      "@/utils": ["./utils"],
      "@/utils/*": ["./utils/*"]
    }
  },
  "include": ["next-env.d.ts", "global.d.ts", "**/*.ts", "**/*.tsx", "**/*.css", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
