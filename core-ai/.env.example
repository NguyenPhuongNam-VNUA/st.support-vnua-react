# Application Environment & Server
APP_ENV=development
CORE_AI_HOST=0.0.0.0
CORE_AI_PORT=5001

# Security & Authentication (Internal Service Token)
# Supports both INTERNAL_SERVICE_TOKEN and AI_AGENT_SERVICE_TOKEN for backwards compatibility with Next.js BFF
INTERNAL_SERVICE_TOKEN=change-me-to-a-secure-internal-secret
AI_AGENT_SERVICE_TOKEN=change-me-to-a-secure-internal-secret

# Multi-Tenant Configuration
DEFAULT_TENANT=vnua
ALLOWED_TENANTS=vnua

# LLM Gateway Configuration (LiteLLM abstraction)
# Supported providers: gemini (default), openai, openai_compatible (vLLM, Ollama)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_EXTERNAL_CALLS=2

# LLM Fallback Configuration
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

# Gemini Embedding 2 (1024d remains compatible with the current pgvector schema)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1024
# The standard GOOGLE_API_KEY and GEMINI_API_KEY names are also accepted.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_CONCURRENCY=5

# PostgreSQL Database (Supavisor Transaction Pooler on Port 6543)
# CRITICAL: statement_cache_size=0 is strictly required for transaction pooling mode
DATABASE_URL=postgresql://user:password@supavisor-host:6543/postgres?ssl=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=3
DB_STATEMENT_CACHE_SIZE=0

# Redis Cache (Semantic Cache, Idempotency & Rate Limiting)
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_MAX_CONNECTIONS=30

# MCP (Model Context Protocol) Gateway Configuration
MCP_TRANSPORT=streamable-http
MCP_TOOL_TIMEOUT_SECONDS=3
MCP_ALLOWED_TOOLS=search_knowledge,lookup_schedule,check_tuition,get_regulations,create_support_case

# Observability & Tracing (OpenTelemetry & Prometheus)
OTEL_SERVICE_NAME=st-care-core-ai
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_RAW_PROMPTS=false
