# Core AI server
APP_ENV=development
CORE_AI_HOST=0.0.0.0
CORE_AI_PORT=5001
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_DEADLINE_SECONDS=30

# Must be identical to AI_AGENT_SERVICE_TOKEN in the Node .env file
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-shared-secret

# Tenant isolation
DEFAULT_TENANT=vnua
ALLOWED_TENANTS=vnua

# Gemini: one API key, one answer model, one embedding model
GOOGLE_API_KEY=replace-with-your-google-ai-api-key
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_EXTERNAL_CALLS=2
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_TIMEOUT_SECONDS=20
EMBEDDING_MAX_CONCURRENCY=5
RERANKER_TIMEOUT_SECONDS=1.5
RETRIEVAL_TOP_K=3
TOPIC_IN_DOMAIN_THRESHOLD=0.38
TOPIC_CLARIFY_THRESHOLD=0.52
EVIDENCE_LOW_THRESHOLD=0.58
EVIDENCE_HIGH_THRESHOLD=0.78

# Optional local defense/reranking. Weights must be downloaded explicitly.
LOCAL_MODELS_ENABLED=true
LOCAL_MODELS_DEVICE=cpu
LOCAL_MODELS_BACKEND=auto
PROMPT_GUARD_MODEL_PATH=./models/Llama-Prompt-Guard-2-86M
PROMPT_GUARD_THRESHOLD=0.80
PROMPT_GUARD_TIMEOUT_SECONDS=0.8
BGE_RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3

# PostgreSQL / Supabase Supavisor transaction pooler
DATABASE_URL=postgresql://user:password@your-pooler-host:6543/postgres?ssl=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT_SECONDS=3
DB_STATEMENT_CACHE_SIZE=0

# Redis
REDIS_PASSWORD=replace-with-redis-password
# Used when running core-ai directly; Docker Compose builds its internal URL from REDIS_PASSWORD.
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=30
RATE_LIMIT_PER_MINUTE=60
IDEMPOTENCY_TTL_SECONDS=600
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.93
SEMANTIC_CACHE_MAX_CANDIDATES=200
KNOWLEDGE_VERSION=v1

# Document ingestion
INGESTION_ALLOWED_HOSTS=your-project.supabase.co
INGESTION_MAX_FILE_BYTES=26214400
INGESTION_MAX_PDF_PAGES=200
INGESTION_OCR_MIN_CONFIDENCE=0.55
INGESTION_CHUNK_MIN_TOKENS=300
INGESTION_CHUNK_MAX_TOKENS=600

# MCP tools
MCP_TRANSPORT=streamable-http
MCP_TOOL_TIMEOUT_SECONDS=3
MCP_MAX_RESULT_BYTES=65536
MCP_ALLOWED_TOOLS=search_knowledge,lookup_schedule,check_tuition,get_regulations,create_support_case

# Optional Node business API for authenticated MCP tools.
# Leave both empty until those internal endpoints are available.
BUSINESS_API_BASE_URL=http://host.docker.internal:3000/api
# Must be identical to BUSINESS_API_TOKEN in the Node .env file.
BUSINESS_API_TOKEN=replace-with-the-node-business-api-secret
BUSINESS_API_TIMEOUT_SECONDS=2.5

# Observability (OTLP endpoint is optional)
OTEL_SERVICE_NAME=st-care-core-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_RAW_PROMPTS=false

# Monitoring profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-dashboard-password
